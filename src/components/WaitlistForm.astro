---
interface Props {
  id: string;
  /** Show the optional free-text note field (used on the bottom early-access form). */
  withNote?: boolean;
  cta?: string;
}

const { id, withNote = false, cta = 'Request early access' } = Astro.props;
---

<div class="w-full">
  <form
    action="https://formspree.io/f/mrevognv"
    method="POST"
    class="waitlist-form flex flex-col gap-3 w-full"
    aria-describedby={`${id}-status`}
  >
    <input type="hidden" name="_subject" value="Layerwatch early access" />
    <input type="hidden" name="source" value={id} />
    <div class="flex flex-col sm:flex-row gap-3">
      <label for={`${id}-email`} class="sr-only">Work email</label>
      <input
        id={`${id}-email`}
        type="email"
        name="email"
        placeholder="you@company.com"
        autocomplete="email"
        required
        class="field flex-1 font-mono"
      />
      {!withNote && (
        <button type="submit" class="btn-primary">
          {cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </button>
      )}
    </div>
    {withNote && (
      <>
        <label for={`${id}-note`} class="text-[13px] text-text-muted">
          The last time you traced a workflow across repos — what was it? <span class="text-text-dim">(optional)</span>
        </label>
        <textarea
          id={`${id}-note`}
          name="note"
          rows="4"
          placeholder="e.g. a report stopped updating; took two of us an afternoon to find the worker was on an old image…"
          class="field resize-y"
        ></textarea>
        <button type="submit" class="btn-primary self-start mt-3">
          {cta}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </button>
      </>
    )}
  </form>
  <p id={`${id}-status`} class="form-status text-sm mt-3 min-h-[1.25rem]" role="status" aria-live="polite" tabindex="-1"></p>
</div>

<script>
  // Submit via fetch so the visitor stays on the page; Formspree answers JSON.
  document.querySelectorAll<HTMLFormElement>('.waitlist-form').forEach((form) => {
    const status = form.parentElement?.querySelector<HTMLElement>('.form-status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    const setStatus = (text: string, tone: string) => {
      if (!status) return;
      status.textContent = text;
      status.className = `form-status text-sm mt-3 min-h-[1.25rem] ${tone}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (button) button.disabled = true;
      setStatus('Sending…', 'text-text-muted');
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(String(response.status));
        form.hidden = true;
        setStatus("✓ Thanks, your early-access request is in. We'll be in touch personally.", 'text-observed');
        status?.focus(); // the form is gone, so keep keyboard focus on the result
      } catch {
        if (button) button.disabled = false;
        setStatus('Something went wrong. Please try again, or email hi@layerwatch.dev.', 'text-error');
      }
    });
  });
</script>
