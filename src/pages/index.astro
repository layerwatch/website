---
import Layout from '../layouts/Layout.astro';

const CELL_COLS = 22;
const CELL_ROWS = 9;
const cells = Array.from({ length: CELL_COLS * CELL_ROWS });
---

<Layout
  title="Layerwatch"
  description="See everything your AI coding agent touches. Layerwatch sits between your AI agent and your system — logging every file read, shell command, and API call before something goes wrong."
>

  <!-- Header -->
  <div class="fixed top-4 sm:top-6 left-1/2 -translate-x-1/2 z-50 w-[calc(100%-2rem)] max-w-6xl">
    <header class="floating-nav flex items-center justify-between px-5 sm:px-7 h-16 rounded-2xl border border-border-subtle bg-surface/70 backdrop-blur-md shadow-[0_8px_30px_rgba(0,0,0,0.35)]">
      <img src="/logo-header.png" alt="Layerwatch" class="h-14 w-auto" />
      <a
        href="https://github.com/layerwatch"
        class="hidden sm:inline-flex items-center gap-2 text-text-muted text-sm hover:text-white transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.75 5.48.75 11.75c0 5.02 3.26 9.28 7.77 10.78.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.1-3.16.69-3.83-1.34-3.83-1.34-.52-1.31-1.26-1.66-1.26-1.66-1.03-.7.08-.69.08-.69 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.52-.29-5.17-1.26-5.17-5.6 0-1.24.44-2.25 1.17-3.04-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.16a10.9 10.9 0 0 1 5.72 0c2.18-1.47 3.14-1.16 3.14-1.16.62 1.57.23 2.73.11 3.02.73.79 1.17 1.8 1.17 3.04 0 4.35-2.66 5.31-5.19 5.59.41.35.77 1.04.77 2.1 0 1.52-.01 2.74-.01 3.11 0 .3.2.66.79.55A11.26 11.26 0 0 0 23.25 11.75C23.25 5.48 18.27.5 12 .5Z"/></svg>
        GitHub
      </a>
    </header>
  </div>

  <!-- Hero -->
  <section class="relative pt-40 pb-32 px-6 flex flex-col items-center text-center overflow-hidden">

    <!-- Background decor -->
    <div class="cell-grid absolute inset-x-0 top-0 h-[560px] pointer-events-none" style={`grid-template-columns: repeat(${CELL_COLS}, 1fr); grid-template-rows: repeat(${CELL_ROWS}, 1fr);`}>
      {cells.map(() => <span class="cell"></span>)}
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-blue-950/30 via-transparent to-background pointer-events-none"></div>
    <div class="blob-a absolute top-[-10%] left-1/2 -translate-x-1/2 w-[900px] h-[900px] bg-primary/10 rounded-full blur-[160px] pointer-events-none"></div>
    <div class="blob-b absolute top-[20%] right-[-10%] w-[500px] h-[500px] bg-primary-light/10 rounded-full blur-[130px] pointer-events-none"></div>
    <div class="blob-c absolute top-[35%] left-[-8%] w-[420px] h-[420px] bg-primary/8 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Badge -->
    <div id="hero-badge" class="relative z-10 mb-8 inline-flex items-center gap-2 bg-surface/60 backdrop-blur-sm border border-primary/30 text-primary-light text-sm px-4 py-1.5 rounded-full shadow-[0_0_15px_rgba(59,130,246,0.15)]">
      <span class="w-1.5 h-1.5 bg-primary rounded-full animate-pulse shadow-[0_0_5px_#3b82f6]"></span>
      Early Access — Join the waitlist
    </div>

    <!-- Headline -->
    <h1 id="hero-headline" class="relative z-10 text-5xl sm:text-6xl md:text-7xl font-extrabold tracking-tighter max-w-4xl leading-[1.05] mb-6">
      See everything your
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-primary-light">AI agent</span>
      touches
    </h1>

    <!-- Subheadline -->
    <p id="hero-sub" class="relative z-10 text-lg sm:text-xl text-text-muted max-w-xl mb-10 leading-relaxed font-light">
      Claude Code, Cursor, and Copilot have unrestricted access to your machine.
      Layerwatch shows you exactly what they read, execute, and touch — in real time.
    </p>

    <!-- Email capture -->
    <form
        action="https://formspree.io/f/mrevognv"
        method="POST"
        class="waitlist-form hero-form relative z-10 flex flex-col sm:flex-row gap-3 w-full max-w-md mb-6"
    >
      <input
        type="email"
        name="email"
        placeholder="you@company.com"
        required
        class="flex-1 bg-surface/80 backdrop-blur-sm border border-border-subtle text-white placeholder-text-muted/70 rounded-lg px-4 py-3 text-sm font-mono focus:outline-none focus:border-primary transition-colors"
      />
      <button
        type="submit"
        class="btn-cta bg-primary text-white font-medium px-6 py-3 rounded-lg text-sm whitespace-nowrap shadow-[0_0_20px_rgba(59,130,246,0.25)]"
      >
        Get Early Access
      </button>
    </form>

    <!-- Success message (hidden by default) -->
    <div class="form-success relative z-10 hidden text-success text-sm mb-6">
      ✓ You're on the list. We'll be in touch.
    </div>

    <!-- Social proof -->
    <p id="hero-note" class="relative z-10 text-text-muted/60 text-xs mb-20">
      No spam. No credit card.
    </p>

    <!-- Product visual -->
    <div id="hero-visual" class="relative z-10 w-full max-w-3xl">
      <div class="absolute -inset-6 bg-primary/10 rounded-[2rem] blur-[80px] pointer-events-none"></div>
      <div class="glass-panel relative rounded-2xl border border-border-subtle overflow-hidden text-left shadow-2xl">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-border-subtle bg-black/20">
          <span class="w-2.5 h-2.5 rounded-full bg-error/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-warning/70"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-success/70"></span>
          <span class="ml-3 font-mono text-xs text-text-muted">layerwatch — session.log</span>
        </div>
        <div class="p-5 font-mono text-[13px] leading-relaxed space-y-2.5">
          <div class="log-row flex gap-3 text-text-muted">
            <span class="text-text-muted/50">14:22:01</span>
            <span class="text-success">ALLOW</span>
            <span>Session started — <span class="text-white">Claude Code</span></span>
          </div>
          <div class="log-row flex gap-3 text-text-muted">
            <span class="text-text-muted/50">14:22:05</span>
            <span class="text-primary-light">EXEC</span>
            <span>ls -la ./src/components</span>
          </div>
          <div class="log-row flex gap-3 text-text-muted">
            <span class="text-text-muted/50">14:22:07</span>
            <span class="text-success">ALLOW</span>
            <span>Read <span class="text-white">./src/lib/auth.ts</span></span>
          </div>
          <div class="log-row flex flex-wrap gap-x-3 gap-y-1.5 items-center rounded-lg -mx-2 px-2 py-2 bg-error/10 border border-error/20">
            <span class="text-text-muted/50">14:23:11</span>
            <span class="text-error font-semibold">BLOCK</span>
            <span class="text-white">Read attempt: <span class="text-warning">.env.production</span></span>
            <span class="sm:ml-auto text-[11px] text-error/80 border border-error/30 rounded px-1.5 py-0.5 whitespace-nowrap">secret detected</span>
          </div>
          <div class="log-row flex gap-3 text-text-muted">
            <span class="text-text-muted/50">14:23:12</span>
            <span class="text-primary-light">PROXY</span>
            <span>MCP call to <span class="text-white">filesystem-server</span> logged</span>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Pain points -->
  <section class="relative px-6 py-24 border-t border-border-subtle">
    <div class="absolute inset-0 grid-bg opacity-20 pointer-events-none"></div>
    <div class="max-w-4xl mx-auto relative z-10">

      <div class="section-heading flex flex-col items-center mb-12">
        <span class="eyebrow mb-4">The Problem</span>
        <p class="text-center text-text-muted text-sm uppercase tracking-widest font-mono">
          What's happening right now on your machine
        </p>
      </div>

      <div class="card-grid grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="card glass-card rounded-2xl p-7">
          <div class="w-10 h-10 rounded-lg bg-warning/10 border border-warning/20 flex items-center justify-center mb-5 text-warning">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Silent file access</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            Your AI agent reads <code class="text-error/90 bg-black/30 px-1 py-0.5 rounded font-mono text-xs">.env</code>, <code class="text-error/90 bg-black/30 px-1 py-0.5 rounded font-mono text-xs">~/.aws/credentials</code>, and SSH keys without telling you.
          </p>
        </div>

        <div class="card glass-card rounded-2xl p-7">
          <div class="w-10 h-10 rounded-lg bg-warning/10 border border-warning/20 flex items-center justify-center mb-5 text-warning">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 2.64-6.36L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>
          </div>
          <h3 class="text-white font-semibold mb-2">No audit trail</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            When something goes wrong, there is no log of what your agent accessed, executed, or modified during the session.
          </p>
        </div>

        <div class="card glass-card rounded-2xl p-7">
          <div class="w-10 h-10 rounded-lg bg-warning/10 border border-warning/20 flex items-center justify-center mb-5 text-warning">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="8" rx="2"/><rect x="2" y="13" width="20" height="8" rx="2"/><path d="M6 7h.01"/><path d="M6 17h.01"/></svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Unvetted MCP servers</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            Third-party MCP tools your agent calls can exfiltrate data to endpoints you never audited or approved.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- What Layerwatch does -->
  <section class="relative px-6 pb-24 border-t border-border-subtle overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-25 pointer-events-none"></div>
    <div class="blob-d absolute top-[10%] left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-primary/8 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="max-w-3xl mx-auto text-center pt-24 relative z-10">

      <div class="section-heading flex flex-col items-center mb-4">
        <span class="eyebrow mb-4">The Solution</span>
        <h2 class="text-4xl sm:text-5xl font-extrabold tracking-tight">
          The layer your AI agent is missing
        </h2>
      </div>
      <p class="section-sub text-text-muted mb-16 leading-relaxed">
        Layerwatch sits between your AI coding agent and everything it can touch —
        giving you visibility, control, and a tamper-evident audit trail.
      </p>

      <div class="card-grid grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">

        <div class="card glass-card flex gap-4 p-6 rounded-2xl">
          <div class="icon-badge icon-badge-success w-9 h-9 shrink-0 rounded-lg bg-success/10 border border-success/20 flex items-center justify-center text-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg>
          </div>
          <div>
            <h4 class="text-white font-medium mb-1">Session timeline</h4>
            <p class="text-text-muted text-sm">Every file read, command run, and API call — in chronological order, replayable.</p>
          </div>
        </div>

        <div class="card glass-card flex gap-4 p-6 rounded-2xl">
          <div class="icon-badge icon-badge-success w-9 h-9 shrink-0 rounded-lg bg-success/10 border border-success/20 flex items-center justify-center text-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div>
            <h4 class="text-white font-medium mb-1">Secret detection</h4>
            <p class="text-text-muted text-sm">Scans context before the prompt fires. Catches API keys, tokens, and credentials before they leave your machine.</p>
          </div>
        </div>

        <div class="card glass-card flex gap-4 p-6 rounded-2xl">
          <div class="icon-badge icon-badge-success w-9 h-9 shrink-0 rounded-lg bg-success/10 border border-success/20 flex items-center justify-center text-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div>
            <h4 class="text-white font-medium mb-1">MCP proxy</h4>
            <p class="text-text-muted text-sm">Intercepts every tool call your agent makes. Log, inspect, and block based on rules you define.</p>
          </div>
        </div>

        <div class="card glass-card flex gap-4 p-6 rounded-2xl">
          <div class="icon-badge icon-badge-success w-9 h-9 shrink-0 rounded-lg bg-success/10 border border-success/20 flex items-center justify-center text-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
          </div>
          <div>
            <h4 class="text-white font-medium mb-1">Team dashboard</h4>
            <p class="text-text-muted text-sm">See agent activity across your entire engineering team. Set policies, get alerts, export compliance reports.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="relative border-t border-border-subtle px-6 pt-16 pb-8 overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-px bg-gradient-to-r from-transparent via-primary/40 to-transparent"></div>
    <div class="footer-blob absolute bottom-[-20%] left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-primary/8 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-4xl mx-auto relative z-10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-12">
        <img src="/logo-header.png" alt="Layerwatch" class="h-10 w-auto self-start" />

        <div class="footer-connect flex items-center gap-6">
          <p class="text-text-muted/50 text-xs uppercase tracking-widest font-mono">Connect</p>
          <ul class="flex items-center gap-6 text-sm">
            <li><a href="https://github.com/layerwatch" class="text-text-muted hover:text-white transition-colors">GitHub</a></li>
            <li><a href="https://x.com/layerwatch" class="text-text-muted hover:text-white transition-colors">X</a></li>
            <li><a href="mailto:hi@layerwatch.dev" class="text-text-muted hover:text-white transition-colors">Contact</a></li>
          </ul>
        </div>
      </div>

      <div class="pt-6 border-t border-border-subtle">
        <p class="text-text-muted/60 text-xs">© 2026 Layerwatch. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Animations -->
  <script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Hero entrance
    const heroTl = gsap.timeline({ defaults: { ease: 'power2.out' } });
    heroTl
      .from('#hero-badge', { opacity: 0, y: 12, duration: 0.5 })
      .from('#hero-headline', { opacity: 0, y: 20, duration: 0.6 }, '-=0.3')
      .from('#hero-sub', { opacity: 0, y: 16, duration: 0.5 }, '-=0.35')
      .from('.hero-form', { opacity: 0, y: 16, duration: 0.5 }, '-=0.3')
      .from('#hero-note', { opacity: 0, duration: 0.4 }, '-=0.25')
      .from('#hero-visual', { opacity: 0, y: 32, duration: 0.7, ease: 'power2.out' }, '-=0.2');

    // Ambient cell grid — a small handful of glows drift between random cells,
    // like they're shifting around the grid rather than a busy fixed pattern.
    const cellEls = Array.from(document.querySelectorAll('.cell'));
    const PULSE_SLOTS = 9;

    const pulseRandomCell = () => {
      const cell = cellEls[Math.floor(Math.random() * cellEls.length)];
      gsap.to(cell, {
        backgroundColor: 'rgba(96, 165, 250, 0.55)',
        boxShadow: '0 0 14px 2px rgba(59, 130, 246, 0.45)',
        duration: gsap.utils.random(1.3, 2.4),
        yoyo: true,
        repeat: 1,
        ease: 'sine.inOut',
        onComplete: () => gsap.delayedCall(gsap.utils.random(0.3, 0.9), pulseRandomCell),
      });
    };

    for (let i = 0; i < PULSE_SLOTS; i++) {
      gsap.delayedCall(gsap.utils.random(0, 1), pulseRandomCell);
    }

    // Ambient blob drift — varied timing per blob so they don't move in lockstep
    const blobDrift = [
      { selector: '.blob-a', x: 40, y: 20, duration: 16 },
      { selector: '.blob-b', x: -35, y: 30, duration: 12 },
      { selector: '.blob-c', x: 25, y: -25, duration: 19 },
      { selector: '.blob-d', x: -30, y: 15, duration: 15 },
      { selector: '.footer-blob', x: 30, y: 0, duration: 13 },
    ];
    blobDrift.forEach(({ selector, x, y, duration }) => {
      gsap.to(selector, { x, y, duration, repeat: -1, yoyo: true, ease: 'sine.inOut' });
    });

    // Floating nav: tighten up slightly once the page scrolls
    const nav = document.querySelector('.floating-nav');
    ScrollTrigger.create({
      start: 'top -40',
      onUpdate: (self) => {
        if (!nav) return;
        nav.classList.toggle('is-scrolled', self.scroll() > 40);
      },
    });

    // Log rows stagger inside the product visual
    gsap.from('.log-row', {
      opacity: 0,
      x: -8,
      duration: 0.4,
      stagger: 0.08,
      delay: 1.1,
      ease: 'power1.out',
    });

    // Section eyebrow + heading reveals
    document.querySelectorAll('.section-heading').forEach((el) => {
      gsap.from(el.children, {
        opacity: 0,
        y: 20,
        duration: 0.5,
        stagger: 0.08,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 85%' },
      });
    });

    document.querySelectorAll('.section-sub').forEach((el) => {
      gsap.from(el, {
        opacity: 0,
        y: 16,
        duration: 0.5,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });

    // Card grid stagger reveals, scoped per section
    document.querySelectorAll('.card-grid').forEach((grid) => {
      gsap.from(grid.querySelectorAll('.card'), {
        opacity: 0,
        y: 24,
        duration: 0.5,
        stagger: 0.08,
        ease: 'power2.out',
        scrollTrigger: { trigger: grid, start: 'top 85%' },
      });
    });

    // Footer reveal
    gsap.from('.footer-connect li', {
      opacity: 0,
      y: 10,
      duration: 0.4,
      stagger: 0.06,
      ease: 'power2.out',
      scrollTrigger: { trigger: '.footer-connect', start: 'top 92%' },
    });

    // Hover micro-interactions
    const bindHover = (selector, hoverVars, restVars) => {
      document.querySelectorAll(selector).forEach((el) => {
        el.addEventListener('mouseenter', () => gsap.to(el, hoverVars));
        el.addEventListener('mouseleave', () => gsap.to(el, restVars));
      });
    };
    bindHover('.card', { y: -4, scale: 1.01, duration: 0.25, ease: 'power2.out' }, { y: 0, scale: 1, duration: 0.25, ease: 'power2.out' });
    bindHover('.btn-cta', { scale: 1.04, duration: 0.2, ease: 'power2.out' }, { scale: 1, duration: 0.2, ease: 'power2.out' });
  });
</script>

  <!-- Email capture script -->
  <script>
  const forms = document.querySelectorAll<HTMLFormElement>('.waitlist-form');

  forms.forEach((form) => {
    const successMessage = form.nextElementSibling as HTMLElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const data = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          form.classList.add('hidden');
          successMessage?.classList.remove('hidden');
        } else {
          alert('Something went wrong. Please try again.');
        }
      } catch {
        alert('Something went wrong. Please try again.');
      }
    });
  });
</script>

</Layout>
