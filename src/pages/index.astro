---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HeroAnswer from '../components/HeroAnswer.astro';
import WorkflowMap from '../components/WorkflowMap.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import LayerScroll from '../components/LayerScroll.astro';

const heroQuestions = ['Where does this data actually go?', 'Which setting is live, and who set it?', 'What really reached production?'];

const sources = ['Git repositories', 'Python', 'Celery', 'Redis', 'Kubernetes', 'Helm', 'Kustomize', 'PostgreSQL', 'OpenTelemetry'];

// The hidden-datastore incident: clues an engineer has to piece together from
// four different places. (The concurrency example lives in the hero.)
const fragments = [
  { where: 'ingest-service · api/assets.py', what: 'producer', value: 'reports.build.delay(asset_id)', basis: 'declared', rot: '-rotate-2' },
  { where: 'worker-service · tasks.py', what: 'consumer writes to', value: 'os.environ["REPORT_DB_URL"]', basis: 'declared', rot: 'rotate-1' },
  { where: 'k8s · prod/report-worker', what: 'REPORT_DB_URL comes from', value: 'secret: reporting-db', basis: 'configured', rot: '-rotate-1' },
  { where: '#backend · 3 weeks later', what: 'a customer reports a bug', value: '"wait, which database does the report page read?"', rot: 'rotate-2', question: true },
];

const labels = [
  { basis: 'declared', body: 'A source file or manifest says so. It shows intent, not proof that it runs.' },
  { basis: 'configured', body: 'A supported path from code through deploy inputs resolves to this effective value.' },
  { basis: 'observed', body: 'A named source reported this state at a specific time, for a specific instance.' },
  { basis: 'inferred', body: 'AI or partial analysis proposes it. Useful, clearly marked, never promoted on its own.' },
  { basis: 'unresolved', body: 'Evidence is missing, conflicting or unsupported, so we say that instead of guessing.' },
];

// MCP tools shown in the "For coding agents" section: [name, what it returns]
const agentTools = [
  ['get_workflow', 'nodes, edges, evidence and unknowns'],
  ['get_setting', 'configured vs observed, with derivation'],
  ['get_changes', 'what moved between two snapshots'],
  ['get_coverage', 'missing access, stale sources, failures'],
];

// Trust commitments — only points not already covered by the Layers "Access" rows.
const principles = [
  { title: 'Redacted before it leaves', color: '#f472b6', body: 'Sensitive values are removed before anything is stored, exported or sent to a model.', icon: 'M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.1A10 10 0 0 1 12 5c6 0 10 7 10 7a18 18 0 0 1-3.2 4M6.6 6.6C3.9 8.3 2 12 2 12s4 7 10 7a9.7 9.7 0 0 0 5.4-1.6' },
  { title: 'Your choice of model', color: '#a78bfa', body: 'Use a hosted model or an approved local one. The processing mode is always explicit, so you know what leaves your environment.', icon: 'M9 3v2M15 3v2M9 19v2M15 19v2M3 9h2M3 15h2M19 9h2M19 15h2M7 5h10v14H7z' },
  { title: 'Deletion that sticks', color: '#fbbf24', body: 'Remove a source or revoke access, and the evidence, cached answers and exports built from it are removed too.', icon: 'M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3' },
  { title: 'Open-source core', color: '#34d399', body: 'The collectors, evidence model, local UI and MCP server are planned as open source.', icon: 'M8 6l-6 6 6 6M16 6l6 6-6 6' },
];

const partnerFit = ['Several services spread across more than one repo', 'Cross-repo investigations or handovers that keep coming back', 'Someone who can connect the relevant repos and cluster'];

const faqs = [
  {
    q: "Can't Claude or ChatGPT already do this?",
    a: 'With the same access, a strong agent can reconstruct many of these answers. It has to do it again every session and for every person. Layerwatch does the collection, identity binding, revision tracking and refresh once, keeps it current, and serves the same facts to people and agents. If your team rarely needs this, a general agent may be enough, and we would rather you knew that.',
  },
  {
    q: 'Does it need production access?',
    a: 'It uses access you already have, scoped to one application. Missing access shows up as a coverage gap rather than a workaround, and you can start with a staging environment.',
  },
  {
    q: 'Is it read-only?',
    a: 'Collection is non-mutating for your business data, but "read-only" is not the whole story. Celery inspection publishes control messages over the broker, and catalog queries still use database resources. Each call is allowlisted, with rate and time limits.',
  },
  {
    q: 'Will it tell me why something was built this way?',
    a: 'Only if someone recorded it. We can explain what an index or cache does and what the evidence suggests it helps with. If the original decision was never written down, the answer is "not recorded", not an invented backstory.',
  },
];
---

<Layout
  title="Layerwatch — know what your system actually does"
  description="Layerwatch joins your repositories, deployment config and running infrastructure into one evidence-backed map of each workflow, for engineers and their coding agents."
>
  <div id="ambient" data-tone="blue" aria-hidden="true"></div>
  <div id="progress" aria-hidden="true"></div>
  <Nav />

  <main id="main" class="relative z-10">

    <!-- ============ HERO ============ -->
    <section class="aurora relative px-6 pt-32 sm:pt-40 pb-20 lg:pb-28 overflow-hidden">
      <div class="absolute inset-0 hairline-grid pointer-events-none"></div>

      <div class="relative max-w-6xl mx-auto grid lg:grid-cols-[1.05fr_1fr] gap-14 lg:gap-8 items-center">
        <div class="text-center lg:text-left">
          <p class="hero-in inline-flex items-center gap-2.5 rounded-full border border-border-strong bg-surface/60 backdrop-blur px-3.5 py-1.5 text-[12.5px] text-text-muted mb-8">
            <span class="relative flex w-2 h-2">
              <span class="absolute inline-flex h-full w-full rounded-full bg-observed opacity-60 motion-safe:animate-ping"></span>
              <span class="relative inline-flex w-2 h-2 rounded-full bg-observed"></span>
            </span>
            Private preview · for Python, Celery &amp; Kubernetes teams
          </p>

          <h1 class="hero-in display text-[2.6rem] sm:text-[3.4rem] lg:text-[3.9rem] mb-6">
            Know what your system <span class="serif-accent gradient-text text-[1.12em] pr-1">actually</span> does.
          </h1>

          <p class="hero-in text-lg text-text-muted leading-relaxed max-w-lg mx-auto lg:mx-0 mb-7">
            Your app's behaviour is split across repos, deploy config and running infrastructure, and they often disagree.
            Layerwatch joins them and shows what's really live, with the evidence. For engineers and their coding agents.
          </p>

          <ul class="hero-in space-y-2 mb-9 text-[15px] text-text max-w-md mx-auto lg:mx-0 text-left inline-block lg:block">
            {heroQuestions.map((q) => (
              <li class="flex items-center gap-3">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="text-observed shrink-0" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                {q}
              </li>
            ))}
          </ul>

          <div class="hero-in max-w-md mx-auto lg:mx-0">
            <WaitlistForm id="hero" />
          </div>
        </div>

        <div class="hero-visual relative px-2 sm:px-10 lg:px-0 pb-8 sm:pb-20">
          <HeroAnswer />
        </div>
      </div>
    </section>

    <!-- ============ SOURCES MARQUEE ============ -->
    <section aria-label="Sources Layerwatch reads" class="relative border-y border-border-subtle bg-[#0c1428] py-5">
      <div class="marquee overflow-hidden">
        <div class="marquee-track">
          {[0, 1].map((dup) => (
            <ul class="flex items-center shrink-0" aria-hidden={dup === 1 ? 'true' : undefined}>
              {sources.map((s) => (
                <li class="flex items-center gap-10 pr-10 font-mono text-[13px] text-text-muted whitespace-nowrap">
                  {s}<span class="w-1 h-1 rounded-full bg-border-strong"></span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ PROBLEM ============ -->
    <section id="problem" data-tone="warm" class="band relative px-6 py-20 sm:py-24">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-16 items-center">
        <div class="reveal">
          <p class="eyebrow mb-5">The problem</p>
          <h2 class="display text-4xl sm:text-5xl mb-6">
            The answer is never <span class="serif-accent tone-accent">in one place.</span>
          </h2>
          <div class="space-y-4 text-text-muted leading-relaxed text-[17px]">
            <p>A producer in one repo. A consumer in another. A queue picked by config. A value overridden at deploy time. A new database nobody mentioned until a customer reported a bug.</p>
            <p>Docs generated from one repository can be perfectly coherent and still answer the wrong question. Every investigation starts from scratch, usually by pinging whoever built it.</p>
          </div>
          <p class="mt-8 font-mono text-sm text-text">
            Two repos, a Kubernetes secret and a Slack thread. Nobody had the whole picture. <span class="text-text-dim">→</span>
          </p>
        </div>

        <div class="reveal grid sm:grid-cols-2 gap-4 sm:gap-5 relative">
          <div class="absolute -inset-10 pointer-events-none" style="background: radial-gradient(closest-side, rgba(59,130,246,0.14), transparent)"></div>
          {fragments.map((f, i) => (
            <div class={`frag panel paper rounded-2xl p-5 relative ${f.rot} ${i % 2 === 1 ? 'sm:translate-y-8' : ''}`}>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="font-mono text-[11px] text-text-dim truncate">{f.where}</span>
                {f.question
                  ? <span class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-unresolved shrink-0">open question</span>
                  : <span class={`chip chip-${f.basis}`}>{f.basis}</span>}
              </div>
              <p class="font-mono text-[12px] text-text-muted">{f.what}</p>
              <p class={f.question ? 'mt-1.5 text-[17px] leading-snug text-text font-medium' : 'mt-1.5 font-mono text-[14px] leading-snug text-text break-words'}>{f.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ LAYERS (pinned scroll) ============ -->
    <LayerScroll />

    <!-- ============ WORKFLOW MAP ============ -->
    <section id="map" data-tone="teal" class="relative px-6 py-20 sm:py-24 overflow-hidden">
      <div class="relative max-w-6xl mx-auto">
        <div class="reveal grid lg:grid-cols-2 gap-6 lg:gap-16 items-end mb-12">
          <div>
            <p class="eyebrow mb-5">Workflow map</p>
            <h2 class="display text-4xl sm:text-5xl">Follow one workflow, <span class="serif-accent tone-accent">not the whole company.</span></h2>
          </div>
          <p class="text-text-muted text-[17px] leading-relaxed">
            Remember the Slack question, "which database does the report page read?" This is the whole path from API to database, with evidence on every link. Click any step.
          </p>
        </div>

        <div class="reveal">
          <WorkflowMap />
        </div>

        <div class="mt-10">
          <p class="reveal text-center text-text-muted mb-6">
            Every claim carries one of five labels. <span class="text-text">No blended confidence score.</span>
          </p>
          <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3">
            {labels.map((l) => (
              <div class={`label-card spot chip-${l.basis} rounded-xl border border-border-subtle bg-surface/60 p-4`} style="--spot: var(--chip)">
                <span class={`chip chip-${l.basis} mb-3`}>{l.basis}</span>
                <p class="text-[13px] text-text-muted leading-relaxed">{l.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============ AGENTS / MCP ============ -->
    <section id="agents" data-tone="violet" class="relative px-6 py-20 sm:py-24 overflow-hidden">
      <div class="relative max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-14 items-center">
        <div class="reveal">
          <p class="eyebrow mb-5">For coding agents</p>
          <h2 class="display text-4xl sm:text-5xl mb-6">Your agent gets the same facts, <span class="serif-accent tone-accent">and the same limits.</span></h2>
          <p class="text-text-muted text-[17px] leading-relaxed mb-8">
            A local MCP server exposes typed, bounded tools. Claude Code, Cursor or any MCP client can pull the workflow, a setting's derivation or the coverage gaps without re-reading five repos every session.
          </p>
          <ul class="space-y-3 text-[15px]">
            {agentTools.map(([fn, d]) => (
              <li class="flex gap-3 items-baseline">
                <code class="font-mono text-[13px] code-fn shrink-0">{fn}</code>
                <span class="text-text-muted">{d}</span>
              </li>
            ))}
          </ul>
          <p class="mt-8 text-sm text-text-dim">No shell tool. No arbitrary SQL. No cluster mutation.</p>
        </div>

        <div class="reveal relative">
          <div class="absolute -inset-8 pointer-events-none" style="background: radial-gradient(closest-side, rgba(59,130,246,0.16), transparent)"></div>
          <div class="relative panel paper rounded-2xl overflow-hidden">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-border-subtle bg-black/[0.03]">
              <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]/70"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]/70"></span>
              <span class="ml-3 font-mono text-xs text-text-dim">mcp · layerwatch (stdio)</span>
            </div>
            <pre tabindex="0" aria-label="Example MCP tool call and result" class="p-5 sm:p-6 font-mono text-[12.5px] leading-[1.75] overflow-x-auto"><code><span class="code-dim">→ tool call</span>
<span class="code-fn">get_setting</span>(workload=<span class="code-str">"report-worker"</span>, setting=<span class="code-str">"concurrency"</span>, env=<span class="code-str">"prod"</span>)

<span class="code-dim">← result</span>
{"{"}
  <span class="code-key">"snapshot"</span>: <span class="code-str">"snap_0928_1422"</span>,
  <span class="code-key">"configured"</span>: {"{"} <span class="code-key">"value"</span>: <span class="code-num">30</span>, <span class="code-key">"basis"</span>: <span class="code-str">"configured"</span> {"}"},
  <span class="code-key">"observed"</span>: [
    {"{"} <span class="code-key">"instance"</span>: <span class="code-str">"report-worker-7f9c"</span>, <span class="code-key">"value"</span>: <span class="code-num">30</span>,
      <span class="code-key">"observed_at"</span>: <span class="code-str">"2026-09-28T14:22:07Z"</span> {"}"}
  ],
  <span class="code-key">"shadowed"</span>: [<span class="code-str">"settings.py:12 default=8"</span>],
  <span class="code-key">"conflicts"</span>: [<span class="code-str">"ConfigMap now 50; pods predate edit"</span>],
  <span class="code-key">"limitations"</span>: [<span class="code-str">"report-worker-2c1d runs the previous image"</span>]
{"}"}<span class="caret"></span></code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PRINCIPLES ============ -->
    <section id="trust" data-tone="teal" class="relative px-6 py-20 sm:py-24">
      <div class="max-w-6xl mx-auto">
        <div class="reveal grid lg:grid-cols-2 gap-6 lg:gap-16 items-end mb-14">
          <div>
            <p class="eyebrow mb-5">Trust</p>
            <h2 class="display text-4xl sm:text-5xl">Built to be trusted <span class="serif-accent tone-accent">with access.</span></h2>
          </div>
          <p class="text-text-muted text-[17px] leading-relaxed">
            The access each layer needs is listed above. On top of that, four commitments about your data. We won't promise "no approval needed", but we'll make approval easy.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-border-subtle bg-border-subtle">
          {principles.map((p) => (
            <div class="principle spot bg-background p-7 hover:bg-surface transition-colors" style={`--spot:${p.color}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="mb-5" style={`color:${p.color}`} aria-hidden="true"><path d={p.icon} /></svg>
              <h3 class="text-text font-medium mb-2">{p.title}</h3>
              <p class="text-sm text-text-muted leading-relaxed">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section id="faq" data-tone="indigo" class="relative px-6 py-20 sm:py-24">
      <div class="max-w-3xl mx-auto">
        <div class="reveal text-center mb-12">
          <p class="eyebrow mb-5 justify-center">FAQ</p>
          <h2 class="display text-4xl sm:text-5xl">Fair questions.</h2>
        </div>
        <div class="divide-y divide-border-subtle border-y border-border-subtle">
          {faqs.map((f) => (
            <details class="faq group py-2">
              <summary class="flex items-center justify-between gap-6 py-4 text-left">
                <span class="text-text text-[17px] font-medium">{f.q}</span>
                <span class="faq-icon shrink-0 w-8 h-8 rounded-full border border-border-strong flex items-center justify-center text-text-muted group-hover:text-white">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                </span>
              </summary>
              <p class="pb-5 pr-12 text-text-muted leading-relaxed">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section id="early-access" data-tone="blue" class="relative px-6 py-20 sm:py-24 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 60% at 50% 50%, rgba(59,130,246,0.14), transparent)"></div>

      <div class="relative max-w-5xl mx-auto panel border-spin rounded-[28px] p-8 sm:p-12 lg:p-14 grid lg:grid-cols-[1fr_1fr] gap-12">
        <div>
          <p class="eyebrow mb-5">Early access</p>
          <h2 class="display text-4xl sm:text-[2.9rem] mb-6">Lost an afternoon tracing a workflow <span class="serif-accent tone-accent">across repos?</span></h2>
          <p class="text-text-muted leading-relaxed mb-6">
            We're opening early access to a small number of backend teams running Python, Celery and Kubernetes. We'll set it up with you and check together whether it actually saves your team time.
          </p>
          <p class="text-[13px] font-mono uppercase tracking-[0.12em] text-text-dim mb-3">A good fit if you have</p>
          <ul class="space-y-2.5 text-[15px] text-text-muted">
            {partnerFit.map((t) => (
              <li class="flex gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-observed shrink-0 mt-0.5" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>
                {t}
              </li>
            ))}
          </ul>
        </div>
        <div class="panel paper rounded-2xl p-6 sm:p-7 flex flex-col justify-center">
          <WaitlistForm id="partner" withNote />
          <p class="text-xs text-text-dim mt-1">We'll only use your email, and any note, to follow up about early access. <a href="/privacy" class="underline underline-offset-4 hover:text-text">Privacy</a></p>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Animations -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // ScrollTrigger remembers and restores scroll positions itself; a refresh should start at the top
    ScrollTrigger.clearScrollMemory('manual');

    const mm = gsap.matchMedia();

    // Recalculate trigger positions once fonts and images have settled,
    // otherwise reveals further down fire late.
    document.fonts?.ready.then(() => ScrollTrigger.refresh());
    window.addEventListener('load', () => ScrollTrigger.refresh());

    mm.add('(prefers-reduced-motion: no-preference)', () => {
      gsap.timeline({ defaults: { ease: 'power3.out' } })
        .from('.hero-in', { opacity: 0, y: 18, duration: 0.7, stagger: 0.08 })
        .from('.hero-visual .panel', { opacity: 0, y: 24, duration: 0.8 }, '-=0.6')
        .from('.ha-row', { opacity: 0, x: -10, duration: 0.45, stagger: 0.12 }, '-=0.3')
        .from('.hero-card', { opacity: 0, y: 14, duration: 0.6 }, '-=0.2');

      // gentle parallax on the answer card
      const visual = document.querySelector<HTMLElement>('.hero-visual');
      if (visual && window.matchMedia('(pointer: fine)').matches) {
        const xTo = gsap.quickTo(visual, 'rotationY', { duration: 0.8, ease: 'power3' });
        const yTo = gsap.quickTo(visual, 'rotationX', { duration: 0.8, ease: 'power3' });
        gsap.set(visual, { transformPerspective: 1200 });
        window.addEventListener('pointermove', (e) => {
          xTo((e.clientX / window.innerWidth - 0.5) * 8);
          yTo((e.clientY / window.innerHeight - 0.5) * -6);
        });
      }

      gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
        gsap.from(el, { opacity: 0, y: 16, duration: 0.6, ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 94%', once: true } });
      });

      const staggerIn = (selector: string, trigger: string) =>
        gsap.from(selector, { opacity: 0, y: 16, duration: 0.5, stagger: 0.06, ease: 'power2.out', scrollTrigger: { trigger, start: 'top 92%', once: true } });

      staggerIn('.principle', '#trust .grid');
      staggerIn('.label-card', '#map .label-card');

      gsap.from('.frag', {
        opacity: 0, y: 40, rotate: 0, duration: 0.8, stagger: 0.12, ease: 'back.out(1.4)',
        scrollTrigger: { trigger: '#problem', start: 'top 85%', once: true },
      });

      // scroll progress bar
      gsap.to('#progress', { scaleX: 1, ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: 0.3 } });

      // hero stack drifts up and fades as it leaves
      gsap.to('.hero-visual', {
        yPercent: -12, opacity: 0.35, ease: 'none',
        scrollTrigger: { trigger: '.hero-visual', start: 'top top+=80', end: 'bottom top', scrub: true },
      });

      // italic accent words fade and slide in (a clip-path reveal cut off
      // accents that wrap onto a second line)
      gsap.utils.toArray<HTMLElement>('h2 .serif-accent').forEach((el) => {
        gsap.from(el, {
          opacity: 0, x: -10, duration: 0.8, ease: 'power2.out', delay: 0.2,
          scrollTrigger: { trigger: el, start: 'top 92%', once: true },
        });
      });
    });
  </script>

  <!-- Ambient colour follows the section in view (runs regardless of motion preference) -->
  <script>
    const ambient = document.getElementById('ambient');
    if (ambient && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          // the hero has no data-tone of its own and uses the default blue
          if (e.isIntersecting) ambient.dataset.tone = (e.target as HTMLElement).dataset.tone ?? 'blue';
        });
      }, { rootMargin: '-45% 0px -45% 0px' });
      document.querySelectorAll('.aurora, section[data-tone]').forEach((s) => io.observe(s));
    }
  </script>

  <!-- Card spotlight follows the pointer -->
  <script>
    document.querySelectorAll<HTMLElement>('.spot').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', `${e.clientX - r.left}px`);
        el.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  </script>
</Layout>
