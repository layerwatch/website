---
// Fonts are self-hosted (bundled from @fontsource) so no visitor request goes
// to a third-party font CDN.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0a1122" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://layerwatch.dev/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@layerwatch" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://layerwatch.dev/og-image.png" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class="bg-background text-text antialiased font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-primary focus:text-white">Skip to content</a>
    <slot />

    <script>
      // A refresh always starts at the top of the page: don't restore the old
      // scroll position, and don't leave section #hashes in the URL.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!location.hash) {
        window.scrollTo(0, 0);
        window.addEventListener('load', () => window.scrollTo(0, 0));
      }

      const dropHash = () => history.replaceState(null, '', location.pathname + location.search);
      const smooth = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');

      // Section links on the same page scroll without writing the #hash.
      // (The skip link keeps its default behaviour so focus moves correctly.)
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
        if (!a || !a.hash || a.hash === '#main') return;
        if (a.origin !== location.origin || a.pathname !== location.pathname) return;
        const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: smooth() });
        dropHash();
      });

      // Email links: on desktop, many people have no default mail app, so a
      // mailto: click just opens an empty tab. Copy the address instead and
      // confirm it. Phones always have a mail app, so they keep mailto.
      const toast = document.createElement('div');
      toast.setAttribute('role', 'status');
      toast.className = 'copy-toast';
      document.body.appendChild(toast);
      let toastTimer: number | undefined;
      const showToast = (text: string) => {
        toast.textContent = text;
        toast.classList.add('is-visible');
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 2200);
      };
      document.addEventListener('click', async (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="mailto:"]');
        if (!a || matchMedia('(pointer: coarse)').matches) return;
        e.preventDefault();
        const address = a.href.replace(/^mailto:/, '').split('?')[0];
        try {
          await navigator.clipboard.writeText(address);
          showToast(`Copied ${address}`);
        } catch {
          location.href = a.href; // clipboard blocked: fall back to the mail app
        }
      });

      // Arriving from another page with a hash (e.g. /#layers): go there once, then drop it.
      if (location.hash && location.hash !== '#main') {
        window.addEventListener('load', () => {
          document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
          dropHash();
        });
      }
    </script>
  </body>
</html>
