---
// Shared shell for the legal pages (privacy, terms): the site nav and footer
// plus prose styles for the slotted sections.
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  effective: string;
}

const { title, description, heading, effective } = Astro.props;
---

<Layout title={title} description={description}>
  <Nav home={false} />

  <main id="main" class="relative px-6 pt-40 pb-28 max-w-3xl mx-auto">
    <span class="eyebrow mb-4">Legal</span>
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mt-4 mb-3">{heading}</h1>
    <p class="text-text-dim text-sm mb-14 font-mono">Effective {effective}</p>

    <div class="legal-content space-y-10 text-text-muted leading-relaxed">
      <slot />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .legal-content :global(h2) {
    color: white;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .legal-content :global(p) { margin-bottom: 0.5rem; }
  .legal-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .legal-content :global(a) {
    color: var(--color-primary-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-content :global(a:hover) { color: white; }
</style>
